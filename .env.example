# ==============================================================================
# VARIABLES DE ENTORNO PARA DESPLIEGUE EN COOLIFY Y DOCKER
# ==============================================================================
# Copia este archivo a .env en el servidor o configúralo en la interfaz de Coolify.
# NUNCA subas credenciales reales a GitHub.

# --- 1. Base de Datos Supabase PostgreSQL (OBLIGATORIA) ----------------------
# Obtén tu URI en: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Usa el modo Pooler (IPv4) puerto 5432 (Session) o 6543 (Transaction)
DATABASE_URL=postgresql://postgres.XXXXXXXXXXXX:TU_PASSWORD_AQUI@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- 2. Seguridad JWT y Roles ------------------------------------------------
# Genera una clave aleatoria segura ejecutando en consola:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=clave_secreta_demo_ferreteria_2026_udabol_cambiar_en_produccion
SECRET_KEY=clave_secreta_demo_ferreteria_2026_udabol_cambiar_en_produccion
JWT_ALGORITHM=HS256
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- 3. Red y Puertos --------------------------------------------------------
# Puerto interno donde escuchará la API en el contenedor
PORT=8000

# --- 4. CORS (Orígenes Permitidos para el Backend) ---------------------------
# Dominio asignado en Coolify para tu aplicación web
CORS_ORIGINS=https://diplomado.cerice360.com,http://diplomado.cerice360.com,https://api.diplomado.cerice360.com

# --- 5. Frontend (Build-Time / Cliente) --------------------------------------
# URL pública del backend consumida desde el navegador del usuario final
# En Coolify, si el backend está en https://api.diplomado.cerice360.com:
VITE_API_URL=https://api.diplomado.cerice360.com/api/v1
