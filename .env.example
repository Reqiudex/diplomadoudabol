# Variables de entorno para Docker Compose
# Copia este archivo a .env y rellena tus valores reales

# ── Base de Datos Supabase PostgreSQL (obligatorio) ───────────────────────────
# Obtén tu cadena de conexión en: Supabase → Project Settings → Database → URI
DATABASE_URL=postgresql://postgres.XXXXXXXXXXXX:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Genera una clave aleatoria segura: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=clave_secreta_larga_y_aleatoria_cambiar_en_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
